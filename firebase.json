{
  "hosting": {
    "site": "starter-forge-rogue-oflo",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/README.md",
      "**/pnpm-lock.yaml",
      "**/biome.jsonc",
      "**/tsconfig.json",
      "**/vitest.config.ts",
      "**/test/**",
      "**/package.json",
      "**/*.bat",
      "**/*.ps1",
      "**/*.tps"
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/asset-manifest.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      }
    ]
  }
}
